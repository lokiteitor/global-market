{
  "$comment": "Proyecto TS del kernel framework-agnostic (shared/, domain/, network/, config/) MÁS game/ (Rendering Layer: usa Phaser pero jamás Vue/Nuxt/Pinia y vive fuera de app/, así que Nuxt no lo typechequea): se typechequea sin Nuxt con las opciones estrictas del FAD §23.2. Complementa a `nuxt typecheck` (ver script typecheck).",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/importMeta"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~shared/*": ["./shared/*"],
      "~domain/*": ["./domain/*"],
      "~network/*": ["./network/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.json",
    "domain/**/*.ts",
    "game/**/*.ts",
    "network/**/*.ts",
    "config/**/*.ts",
    "vitest.config.ts"
  ]
}
