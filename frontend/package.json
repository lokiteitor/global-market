{
  "name": "imperio-industrial-frontend",
  "private": true,
  "type": "module",
  "description": "Cliente web de Imperio Industrial (FAD v1.1). Paquete Node autónomo, npm sin workspaces (ADR-021).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o types/api.d.ts",
    "typecheck": "nuxt typecheck && vue-tsc -p tsconfig.kernel.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.1",
    "nuxt": "^4.4.8",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
